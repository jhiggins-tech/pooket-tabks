{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": true,
        "host": {
          ".write": "!data.exists() || !newData.exists() || data.child('id').val() === newData.child('id').val() || (data.child('ts').val() < now - 3600000 && (!data.parent().child('game').exists() || data.parent().child('game/ts').val() < now - 345600000))",
          ".validate": "newData.hasChildren(['id', 'ts']) && newData.child('id').isString() && newData.child('id').val().length <= 32 && newData.child('ts').isNumber() && newData.child('ts').val() <= now"
        },
        "guest": {
          ".write": "!data.exists() || !newData.exists() || data.child('id').val() === newData.child('id').val()",
          ".validate": "newData.hasChildren(['id', 'ts']) && newData.child('id').isString() && newData.child('id').val().length <= 32 && newData.child('ts').isNumber() && newData.child('ts').val() <= now"
        },
        "h2g": {
          ".write": true,
          "$msg": { ".validate": "newData.isString() && newData.val().length < 300000" }
        },
        "g2h": {
          ".write": true,
          "$msg": { ".validate": "newData.isString() && newData.val().length < 300000" }
        },
        "view": {
          ".write": true,
          "state": { ".validate": "newData.isString() && newData.val().length < 600000" },
          "aim": { ".validate": "newData.isString() && newData.val().length < 4000" },
          "$other": { ".validate": false }
        },
        "game": {
          ".write": true,
          ".validate": "newData.hasChildren(['m', 'ts']) && newData.child('m').isString() && newData.child('m').val().length < 600000 && newData.child('ts').isNumber() && newData.child('ts').val() <= now",
          "m": { ".validate": true },
          "ts": { ".validate": true },
          "$other": { ".validate": false }
        },
        "devices": {
          "$role": {
            ".write": true,
            ".validate": "($role === 'host' || $role === 'guest') && newData.hasChildren(['m', 'ts']) && newData.child('m').isString() && newData.child('m').val().length < 1024 && newData.child('ts').isNumber() && newData.child('ts').val() <= now",
            "m": { ".validate": true },
            "ts": { ".validate": true },
            "$other": { ".validate": false }
          }
        },
        "watchers": {
          "$watcher": {
            ".write": true,
            ".validate": "$watcher.length <= 32 && newData.hasChildren(['m', 'ts']) && newData.child('m').isString() && newData.child('m').val().length < 1024 && newData.child('ts').isNumber() && newData.child('ts').val() <= now",
            "m": { ".validate": true },
            "ts": { ".validate": true },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "replays": {
      "$replay": {
        ".read": true,
        ".write": "!newData.exists()",
        "$entry": {
          ".write": true,
          ".validate": "newData.hasChildren(['m', 'ts']) && newData.child('m').isString() && newData.child('m').val().length < 600000 && newData.child('ts').isNumber() && newData.child('ts').val() <= now",
          "m": { ".validate": true },
          "ts": { ".validate": true },
          "$other": { ".validate": false }
        }
      }
    },
    "replayList": {
      "$lan": {
        ".read": true,
        "$replay": {
          ".write": true,
          ".validate": "newData.hasChildren(['m', 'ts']) && newData.child('m').isString() && newData.child('m').val().length < 4096 && newData.child('ts').isNumber() && newData.child('ts').val() <= now",
          "m": { ".validate": true },
          "ts": { ".validate": true },
          "$other": { ".validate": false }
        }
      }
    },
    "outbox": {
      ".read": "query.orderByChild === 'to' && query.equalTo != null",
      ".indexOn": ["createdAt", "to"],
      "$event": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['type', 'ref', 'to', 'originClientId', 'createdAt']) && newData.child('type').isString() && newData.child('type').val().matches(/^(your-turn|joined)$/) && newData.child('ref').isString() && newData.child('ref').val().matches(/^[0-9a-f]{24}$/) && newData.child('to').isString() && newData.child('to').val().length <= 64 && newData.child('originClientId').isString() && newData.child('originClientId').val().length <= 64 && newData.child('createdAt').val() === now",
        "type": { ".validate": true },
        "ref": { ".validate": true },
        "to": { ".validate": true },
        "originClientId": { ".validate": true },
        "createdAt": { ".validate": true },
        "$other": { ".validate": false }
      }
    },
    "pushSubscriptions": {
      "$sub": {
        ".write": "$sub.matches(/^[0-9a-f]{32}$/)",
        ".validate": "newData.hasChildren(['endpoint', 'keys', 'clientId', 'createdAt']) && newData.child('endpoint').isString() && newData.child('endpoint').val().beginsWith('https://') && newData.child('endpoint').val().length < 1024 && newData.child('clientId').isString() && newData.child('clientId').val().length <= 64 && newData.child('createdAt').val() === now",
        "endpoint": { ".validate": true },
        "keys": {
          ".validate": "newData.hasChildren(['p256dh', 'auth'])",
          "p256dh": { ".validate": "newData.isString() && newData.val().length < 256" },
          "auth": { ".validate": "newData.isString() && newData.val().length < 256" },
          "$other": { ".validate": false }
        },
        "clientId": { ".validate": true },
        "createdAt": { ".validate": true },
        "$other": { ".validate": false }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          ".validate": "newData.hasChild('ts')",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 32" },
          "character": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "sound": { ".validate": "newData.val() === 'on' || newData.val() === 'off'" },
          "listPublicly": { ".validate": "newData.val() === 'yes' || newData.val() === 'no'" },
          "showPast": { ".validate": "newData.val() === 'yes' || newData.val() === 'no'" },
          "ts": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        },
        "push": {
          "$client": {
            ".validate": "$client.matches(/^[0-9a-f-]{8,64}$/) && newData.hasChildren(['ts']) && newData.child('ts').val() === now",
            "ts": { ".validate": true },
            "$other": { ".validate": false }
          }
        },
        "results": {
          "$match": {
            ".validate": "$match.matches(/^[0-9a-f]{24}-[0-9a-z]{1,16}$/) && newData.hasChildren(['seat', 'digest', 'ts']) && (newData.child('seat').val() === 0 || newData.child('seat').val() === 1) && newData.child('digest').isString() && newData.child('digest').val().matches(/^[0-9a-f]{64}$/) && newData.child('ts').val() === now",
            "seat": { ".validate": true },
            "digest": { ".validate": true },
            "ts": { ".validate": true },
            "$other": { ".validate": false }
          }
        },
        "unlocks": {
          "$character": {
            ".validate": "$character.matches(/^[a-z0-9]{1,32}$/) && newData.hasChildren(['ts']) && newData.child('ts').val() === now",
            "ts": { ".validate": true },
            "$other": { ".validate": false }
          }
        },
        "games": {
          "$code": {
            ".validate": "$code.matches(/^[A-Z]{4}$/) && newData.hasChildren(['at', 'ts']) && (newData.child('gone').val() === true || newData.hasChildren(['role', 'id']))",
            "role": { ".validate": "newData.val() === 'host' || newData.val() === 'guest'" },
            "id": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "listed": { ".validate": "newData.isBoolean()" },
            "gone": { ".validate": "newData.val() === true" },
            "at": { ".validate": "newData.isNumber()" },
            "ts": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "stats": {
      "matches": {
        "$match": {
          "$seat": {
            ".write": "!data.exists()",
            ".validate": "$match.matches(/^[0-9a-f]{24}-[0-9a-z]{1,16}$/) && ($seat === '0' || $seat === '1') && newData.hasChildren(['m', 'ts']) && newData.child('m').isString() && newData.child('m').val().length < 16000 && newData.child('ts').val() === now",
            "m": { ".validate": true },
            "ts": { ".validate": true },
            "$other": { ".validate": false }
          }
        }
      },
      "summary": {
        ".read": true
      }
    },
    "lobby": {
      "$lan": {
        ".read": true,
        "$host": {
          ".write": true,
          ".validate": "newData.hasChildren(['m', 'ts']) && newData.child('m').isString() && newData.child('m').val().length < 4096 && newData.child('ts').isNumber() && newData.child('ts').val() <= now",
          "m": { ".validate": true },
          "ts": { ".validate": true },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
